import SuperpermutationUpperBound43586371.GenericBoundsC
import Challenge

/-!
# The bounds for every size from 19 symbols on, and the coefficient 43586371/86486400

The statements are in the vocabulary of `Challenge.lean` (`SuperpermutationBounds.Covers`,
`SuperpermutationBounds.F3`) and have the shape of `finite_bound` and `eventual_bound` of
`Solution.lean` (and of step (B)'s `finite_bound16`), with `43586371/86486400 = 41281/83160 + 654131/86486400` and
`654131/86486400` in place of `43/80`, `17/240`.  They start at 19 symbols (`m ≥ 17`): the construction is the
selection of step (A) (`Certificate.cert`) with nested blocks above its loops without a row
(`Nested2.lean`), closed and completed.  Generated by `gen_bounds.py C` from step (B)'s `MainB.lean`.
-/

namespace SuperpermutationUpperBound43586371

open SuperpermutationUpperBound

private theorem covers_of_construction {K : ℕ} {w : List (Fin K)}
    (h : IsSuperpermutation w) : SuperpermutationBounds.Covers w := by
  intro p hlength hnodup
  obtain ⟨u, v, heq⟩ := h p ⟨hlength, hnodup⟩
  exact ⟨u, v, heq.symm⟩

/-- The finite bound for `m + 2 ≥ 19` symbols and every parameter `2 ≤ a ≤ m`. -/
theorem finite_bound19 (m : Nat) (hm : 17 ≤ m) (a : Nat) (ha : 2 ≤ a) (ham : a ≤ m) :
    ∃ w : List (Fin (m + 2)), SuperpermutationBounds.Covers w ∧
      (w.length : ℚ) ≤
        (((m + 2).factorial + (m + 1).factorial + m.factorial : Nat) : ℚ)
          + (43586371 / 86486400 : ℚ) * ((m - 1).factorial : ℚ)
          + ((a - 2 : Nat) : ℚ) * (654131 / 86486400 : ℚ) * ((m - 1).factorial : ℚ)
              / ((m - 1 : Nat) : ℚ)
          + ((m - a : Nat) : ℚ) *
              min ((654131 / 86486400 : ℚ) * ((m - 1).factorial : ℚ) / ((m - 1 : Nat) : ℚ))
                (((m + 1).factorial : ℚ) / ((a + 1).factorial : ℚ)) := by
  obtain ⟨w, hw, hl⟩ :=
    BoundsC.finite_of_cert m hm a ha ham
  refine ⟨w, covers_of_construction hw, ?_⟩
  simpa only [BoundsC.bound, F3, show m + 2 - 1 = m + 1 by omega,
    show m + 2 - 2 = m by omega] using hl

/-- For every positive rational ε, eventually length at most
`F3(K) + (43586371/86486400 + ε) (K-3)!`. -/
theorem eventual_bound19 :
    ∀ ε : ℚ, 0 < ε → ∃ N : ℕ, 19 ≤ N ∧
      ∀ K : ℕ, N ≤ K → ∃ w : List (Fin K), SuperpermutationBounds.Covers w ∧
        (w.length : ℚ) ≤
          SuperpermutationBounds.F3 K +
            ((43586371 / 86486400 : ℚ) + ε) * (Nat.factorial (K - 3) : ℚ) := by
  intro ε hε
  obtain ⟨N, hN, hall⟩ := BoundsC.asymptotic_of_cert ε hε
  refine ⟨N, hN, ?_⟩
  intro K hK
  obtain ⟨w, hw, hl⟩ := hall K hK
  refine ⟨w, covers_of_construction hw, ?_⟩
  simpa only [SuperpermutationBounds.F3, F3, Fourth, Nat.cast_add] using hl

end SuperpermutationUpperBound43586371

#print axioms SuperpermutationUpperBound43586371.finite_bound19
#print axioms SuperpermutationUpperBound43586371.eventual_bound19
