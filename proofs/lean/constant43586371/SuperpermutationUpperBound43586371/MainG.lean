namespace SuperpermutationUpperBound43586371

open SuperpermutationUpperBound

private theorem covers_of_construction {K : ℕ} {w : List (Fin K)}
    (h : IsSuperpermutation w) : SuperpermutationBounds.Covers w := by
  intro p hlength hnodup
  obtain ⟨u, v, heq⟩ := h p ⟨hlength, hnodup⟩
  exact ⟨u, v, heq.symm⟩

/-- The finite bound for `m + 2 ≥ 22` symbols and every parameter `2 ≤ a ≤ m`. -/
theorem finite_bound22_21736511 (m : Nat) (hm : 20 ≤ m) (a : Nat) (ha : 2 ≤ a) (ham : a ≤ m) :
    ∃ w : List (Fin (m + 2)), SuperpermutationBounds.Covers w ∧
      (w.length : ℚ) ≤
        (((m + 2).factorial + (m + 1).factorial + m.factorial : Nat) : ℚ)
          + (21736511 / 43243200 : ℚ) * ((m - 1).factorial : ℚ)
          + ((a - 2 : Nat) : ℚ) * (56491 / 8648640 : ℚ) * ((m - 1).factorial : ℚ)
              / ((m - 1 : Nat) : ℚ)
          + ((m - a : Nat) : ℚ) *
              min ((56491 / 8648640 : ℚ) * ((m - 1).factorial : ℚ) / ((m - 1 : Nat) : ℚ))
                (((m + 1).factorial : ℚ) / ((a + 1).factorial : ℚ)) := by
  obtain ⟨w, hw, hl⟩ :=
    BoundsG.finite_of_cert m hm a ha ham
  refine ⟨w, covers_of_construction hw, ?_⟩
  simpa only [BoundsG.bound, F3, show m + 2 - 1 = m + 1 by omega,
    show m + 2 - 2 = m by omega] using hl

/-- For every positive rational ε, eventually length at most
`F3(K) + (21736511/43243200 + ε) (K-3)!`. -/
theorem eventual_bound22_21736511 :
    ∀ ε : ℚ, 0 < ε → ∃ N : ℕ, 22 ≤ N ∧
      ∀ K : ℕ, N ≤ K → ∃ w : List (Fin K), SuperpermutationBounds.Covers w ∧
        (w.length : ℚ) ≤
          SuperpermutationBounds.F3 K +
            ((21736511 / 43243200 : ℚ) + ε) * (Nat.factorial (K - 3) : ℚ) := by
  intro ε hε
  obtain ⟨N, hN, hall⟩ := BoundsG.asymptotic_of_cert ε hε
  refine ⟨N, hN, ?_⟩
  intro K hK
  obtain ⟨w, hw, hl⟩ := hall K hK
  refine ⟨w, covers_of_construction hw, ?_⟩
  simpa only [SuperpermutationBounds.F3, F3, Fourth, Nat.cast_add] using hl

