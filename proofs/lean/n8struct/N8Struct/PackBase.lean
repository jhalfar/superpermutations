import N8Struct.Walk27
import N8Struct.Symmetry

/-!
# Fact (4), base: placements, packings, data and general lemmas

A *placement* of the 27-walk is the walk with row lengths `vs27` started at a state `g`
(model.py `walks.placements`); it is determined by `g`, the state of its only row of length 2.
A *packing* is four placements whose loops are pairwise disjoint.

Proved here, all by the kernel (`decide +kernel` plus ordinary proofs, no `native_decide`):
* every state starts a closed 27-walk, and different states give different placements (720);
* the identity placement meets no other placement exactly for the 21 states `partners`;
* classification: every packing is `σ K0` or `σ K1` for a renaming `σ` (as a set of start states,
  equivalently of placements), and every such image is a packing;
* no renaming maps `K0` to `K1`; the stabiliser of each of `K0`, `K1` has 4 elements;
* the packing of the published selection `selection-46174.txt` is `Pstar`, the image of `K1` under
  the renaming `[0,2,1,5,4,3]`; its rows are exactly the 108 rows of the selection, it covers 108
  loops, and the 12 loops without a row are the rest of the 120 loops;
* the Klein group `{id, (25)(34), (01)(34), (01)(25)}` maps `Pstar` to itself, swaps its four walks
  in pairs, and maps the set of the 12 left-over loops onto itself (no non-trivial element fixes
  any single one of them);
* reading backwards maps the rows of `Pstar` to the rows of `PstarRev`, the image of `K0` under the
  renaming `[0,3,4,5,1,2]`, so the reversal joins the two classes (checked at word level: the slices
  of each reversed row are the reversed slices).
-/

namespace N8Struct

open SuperpermutationUpperBound

/-- The 27-walk placed at the state `g`. -/
def placement (g : State) : List (Row Nat) := walkRows g vs27

/-- Four placements with pairwise disjoint loops. -/
def IsPacking (g1 g2 g3 g4 : State) : Prop :=
  IsState g1 ∧ IsState g2 ∧ IsState g3 ∧ IsState g4 ∧
  Disj (placement g1) (placement g2) ∧ Disj (placement g1) (placement g3) ∧
  Disj (placement g1) (placement g4) ∧ Disj (placement g2) (placement g3) ∧
  Disj (placement g2) (placement g4) ∧ Disj (placement g3) (placement g4)

instance (g1 g2 g3 g4 : State) : Decidable (IsPacking g1 g2 g3 g4) := by
  unfold IsPacking
  infer_instance

