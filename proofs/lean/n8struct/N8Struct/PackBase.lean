/-! ## Literal tables, each tied to the definitions by one small `decide` -/

theorem basesId_eq : (placement id6).map Row.base = basesId := by decide +kernel
theorem loopsId_eq : loopsOf (placement id6) = loopsId := by decide +kernel
theorem partnerTable_eq : partners.map (fun a => (a, loopsOf (placement a))) = partnerTable := by
  decide +kernel
theorem coveredLoops_eq : loopsOf (Pstar.flatMap placement) = coveredLoops := by decide +kernel

/-! ## General lemmas on placements -/

theorem vs27_rows : ∀ v ∈ vs27, 1 ≤ v ∧ v ≤ 6 := walk27_closed.2.2.2

theorem placement_relabel (σ g : State) :
    placement (relabel σ g) = (placement g).map (relabelRow σ) := walkRows_relabel σ g vs27

theorem placement_states {g : State} (hg : IsState g) : ∀ r ∈ placement g, IsState r.base :=
  walkRows_states hg vs27_rows

theorem relabel_id6 {σ : State} (hσ : IsState σ) : relabel σ id6 = σ := by
  obtain ⟨hl, -, -⟩ := hσ
  match σ, hl with
  | [_, _, _, _, _, _], _ => rfl

theorem placement_eq_map {g : State} (hg : IsState g) :
    placement g = (placement id6).map (relabelRow g) := by
  rw [← placement_relabel, relabel_id6 hg]

/-- Renaming keeps different loops different. -/
theorem canon_relabel_inj {σ x y : State} (hσ : IsState σ) (hx : IsState x) (hy : IsState y)
    (h : canon (relabel σ x) = canon (relabel σ y)) : canon x = canon y := by
  have hi := (inv_all σ hσ).1
  have := canon_relabel_congr hi (relabel_state hσ hx) (relabel_state hσ hy) h
  rwa [relabel_inv_relabel hσ hx, relabel_inv_relabel hσ hy] at this

/-- All 720 states start a closed 27-walk with 27 different loops (the 720 placed 27-walks),
by renaming `walk27_closed`. -/
theorem placement_closed_all {g : State} (hg : IsState g) : ClosedWalk g vs27 := by
  obtain ⟨-, hend, hnd, hv⟩ := walk27_closed
  refine ⟨hg, ?_, ?_, hv⟩
  · rw [← relabel_id6 hg, walkEnd_relabel, hend]
  · have hP := placement_states (g := id6) (by decide)
    change (loopsOf (placement g)).Nodup
    rw [placement_eq_map hg]
    change (loopsOf (placement id6)).Nodup at hnd
    unfold loopsOf at hnd ⊢
    rw [List.map_map]
    rw [List.Nodup, List.pairwise_map] at hnd ⊢
    refine List.Pairwise.imp_of_mem ?_ hnd
    intro r s hr hs hne heq
    exact hne (canon_relabel_inj hg (hP r hr) (hP s hs) heq)

/-- A placement determines its start state (its first row is the row of length 2 at `g`):
720 different placements. -/
theorem placement_injective {g h : State} (e : placement g = placement h) : g = h := by
  have e' := congrArg (fun l => l.head?.map Row.base) e
  simpa [placement, vs27, walkRows, nrow] using e'

/-- Disjointness through the loop lists. -/
theorem disj_iff_loops (P R : List (Row Nat)) :
    Disj P R ↔ ∀ L ∈ loopsOf P, L ∉ loopsOf R := by
  unfold Disj loopsOf
  constructor
  · intro h L hL hL'
    obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hL
    obtain ⟨s, hs, hrs⟩ := List.mem_map.mp hL'
    exact h r hr s hs hrs.symm
  · intro h r hr s hs he
    exact h _ (List.mem_map_of_mem hr) (he ▸ List.mem_map_of_mem hs)

/-- Boolean disjointness of two loop lists. -/
def disjL (A B : List State) : Bool := A.all (fun L => !(B.contains L))

theorem disj_of_disjL {P R : List (Row Nat)} (h : Disj P R) : disjL (loopsOf P) (loopsOf R) = true := by
  rw [disj_iff_loops] at h
  simp only [disjL, List.all_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true]
  intro L hL
  simpa using h L hL

